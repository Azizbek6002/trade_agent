[Unit]
Description=XAUUSD AI Trading System Service
After=network.target network-online.target

[Service]
Type=simple
User=azizbek
WorkingDirectory=/home/azizbek/Desktop/trade_agent
ExecStart=/usr/bin/python3 /home/azizbek/Desktop/trade_agent/main.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
